# Shared D2 rendering configuration aligned with docs/.vitepress/theme/custom.css.

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 4
    dark-theme-id: 200
    pad: 32
    theme-overrides: {
      N1: "#463723"
      N2: "#544632"
      N3: "#825a28"
      N4: "#c8b4a0"
      N5: "#ead9c6"
      N6: "#faead7"
      N7: "#fff5e6"
      B1: "#78460a"
      B2: "#b36510"
      B3: "#f19d1e"
      B4: "#ffe5bc"
      B5: "#f6d29b"
      B6: "#fff0d8"
      AA2: "#5e7a46"
      AA4: "#a8c18f"
      AA5: "#e9efe3"
      AB4: "#c97965"
      AB5: "#f0ddd1"
    }
    dark-theme-overrides: {
      N1: "#e3d5c8"
      N2: "#c6a78c"
      N3: "#a99380"
      N4: "#4e3c28"
      N5: "#33271f"
      N6: "#1c1611"
      N7: "#0a0704"
      B1: "#f19d1e"
      B2: "#ffac2a"
      B3: "#ca8a04"
      B4: "#5d3a10"
      B5: "#3a250f"
      B6: "#1c1611"
      AA2: "#a8c18f"
      AA4: "#5e7a46"
      AA5: "#26351f"
      AB4: "#c97965"
      AB5: "#3b211c"
    }
  }
}

***.style.font-size: 28

(*** -> ***)[*].style.font-size: 24
